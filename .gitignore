# pytest
.pytest_cache
.cache
.venv
.secrets.local
.env

# Large reverse-engineering artifacts; keep outside commits unless intentionally needed.
*.apk
*.xapk
*.ipa
ios-decompile/

# GITHUB Proposed Python stuff:
*.py[cod]
__pycache__
.secrets.local

# Diagnostic script output (scripts/ble_advert_monitor.py, scripts/state_sampler.py,
# scripts/ble_coverage_map.py) -- regenerated from banked HA history, not a fixed
# point-in-time record, so it must not be committed stale.
scripts/advert_log.jsonl
scripts/state_log.jsonl
scripts/ble_coverage_map.json

# OTA firmware capture (scripts/mitm_ota_capture.py, scripts/fetch_ota_firmware.py,
# scripts/listen_ota_mqtt.py, scripts/ota_safety_net.py,
# scripts/ota_url_probe_burst.py, scripts/probe_ota_endpoints.py) — contains auth
# tokens and/or the firmware binary itself, never commit.
scripts/mitm_ota_capture.jsonl
scripts/ota_mqtt_capture.jsonl
scripts/firmware/

# Raw packet captures from the OTA investigation (tens of MB each, regenerable
# by re-running the capture, never firmware content itself since TLS blocks
# that — see docs/ota-firmware-capture-investigation-20260816.md).
scripts/ota_captures/

# Fail-closed mower TLS probe output: private key, signed OTA URL, request
# headers, and any captured firmware binary.
#
# 🚨 The `scripts/` entry alone was NOT enough: the probe was also run from the
# repo ROOT on 2026-09-05, leaving `mds-key.pem` (a real private key) and a
# signed CDN URL untracked-but-committable, one `git add -A` away from being
# published. Both locations are covered now, plus the working copies.
scripts/ota_tls_probe/
ota_tls_probe/
ota_work/
*.ota

# Coverage data from `pytest --cov` (CI reports to the terminal, never a file)
.coverage
.coverage.*

# Local motion-test artifacts: site-specific yard geometry regenerable from the
# get_map_data service, and transient sweep output overwritten by every run.
scripts/map.json
scripts/sweep_results.json

# Vendor tooling analysed locally, never committed (34MB Windows binary)
LubaLogTools.exe
LubaLogTools.zip
RTKReferenceStationUpgradeTools/
LubaBaseStationUpgrade.app/

# Local copy of upstream pymammotion examples (reference only, not part of this integration)
PyMammotion examples/

# Editor settings: machine-specific and not shareable (the current file is an
# absolute ESP-IDF path in the operator's home directory, unrelated to this
# integration).
.vscode/
