
substitutions:
  display_name: P1S Printer New
  friendly_name: P1S Printer New
  # Higher value gives lower watt readout
  current_res: "0.001"
  # Lower value gives lower voltage readout
  voltage_div: "1720"
  name: p1s-printer


esphome:
  name: ${name}
  friendly_name: ${friendly_name}
  name_add_mac_suffix: false

esp32:
  board: esp-wrover-kit
  variant: esp32
  framework:
    type: esp-idf
    version: recommended  
    
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  ap:
    ssid: !secret p1s_printer__ap_ssid
    password: !secret p1s_printer__ap_password
    ap_timeout: 3min
  reboot_timeout: 30min
captive_portal:

logger:
api:
  encryption:
    key: !secret p1s_printer__encryption_key
ota:
  - platform: esphome
    password: !secret p1s_printer__ota_password
    allow_partition_access: false
    

# web_server:
#   port: 80
#   auth:
#     username: stern
#     password: !secret p1s_printer__web_password
# 
# esp32_ble_tracker:

esp32_ble_tracker:
  id: ble_tracker
  scan_parameters:
    active: false

bluetooth_proxy:
  active: true
switch:
  - platform: template
    name: "${display_name} Bluetooth Scanning"
    id: bluetooth_proxy_enable
    icon: mdi:bluetooth
    optimistic: true
    restore_mode: RESTORE_DEFAULT_ON
    turn_on_action:
      - esp32_ble_tracker.start_scan:
    turn_off_action:
      - esp32_ble_tracker.stop_scan:
  - platform: gpio
    name: ${display_name} Relay1
    pin:
      number: GPIO15
      inverted: false
    id: relay1
    on_turn_on:
      - light.turn_on: relay1_led
    on_turn_off:
      - light.turn_off: relay1_led
    restore_mode: RESTORE_DEFAULT_ON        
  - platform: gpio
    name: ${display_name} Relay2
    pin:
      number: GPIO32
      inverted: false
    id: relay2
    on_turn_on:
      - light.turn_on: relay2_led
    on_turn_off:
      - light.turn_off: relay2_led
    restore_mode: RESTORE_DEFAULT_ON        
  - platform: restart
    name: ${display_name} Restart
  - platform: safe_mode
    name: ${display_name} (Safe Mode)
  - platform: shutdown
    name: ${display_name} (Shutdown)

output:
  - platform: gpio
    pin: GPIO19
    inverted: True
    id: relay1_led_gpio
  - platform: gpio
    pin: GPIO16
    inverted: True
    id: relay2_led_gpio

light:
  - platform: binary
    name: "Relay1 Left LED"
    id: relay1_led
    internal: true    
    output: relay1_led_gpio
  - platform: binary
    name: "Relay2 LED"
    id: relay2_led
    internal: true
    output: relay2_led_gpio

sensor:
#  - platform: dht
#    pin: GPIO25
#    model: AM2302
#    temperature:
#      name: "Living Room Temperature"
#    humidity:
#      name: "Living Room Humidity"
#    update_interval: 12s
  - platform: adc
    pin: GPIO34
    name: "${display_name} LUX"
    device_class: illuminance
    update_interval: 60s
    attenuation: 11db
    unit_of_measurement: lx
    filters:
      - lambda: |-
          return (x / 10000.0) * 2000000.0;
  - platform: hlw8012
    model: BL0937
    sel_pin:
      number: GPIO25
      inverted: true
    cf_pin: GPIO27
    cf1_pin: GPIO26
    current_resistor: ${current_res}
    voltage_divider: ${voltage_div}
    change_mode_every: 3
    update_interval: 60s    
    current:
      name: "${display_name} Amps"
      unit_of_measurement: A
      accuracy_decimals: 2
    voltage:
      name: "${display_name} Volts"
      unit_of_measurement: V
      accuracy_decimals: 1
    power:
      name: "${display_name} Watts"
      unit_of_measurement: W
      accuracy_decimals: 0    
      filters:
        - calibrate_linear:
            - 0.0 -> 0.0
            - 134 -> 58
  - platform: uptime
    name: Uptime Sensor
  - platform: wifi_signal
    name: "WiFi Signal Sensor"
    update_interval: 60s

binary_sensor:
  - platform: gpio
    internal: true
    pin:
      number: GPIO18
      mode: INPUT_PULLDOWN
      inverted: True
    name: ${display_name} Button1
    on_press:
      - switch.toggle: relay1
  - platform: gpio
    internal: true
    pin:
      number: GPIO17
      mode: INPUT_PULLDOWN
      inverted: True
    name: ${display_name} Button2
    on_press:
      - switch.toggle: relay2

status_led:
  pin:
    number: GPIO5
    inverted: true  
