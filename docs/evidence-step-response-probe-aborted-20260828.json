 "the_unresolved_ambiguity": {
  "candidate_a": "Position payloads arrived carrying STALE coordinates -> genuine observer lag >= 2 s.",
  "candidate_b": "No position payloads arrived at all; only generic frames -> a feed stall.",
  "why_this_run_cannot_separate_them": "`last_report_at` stamps EVERY LubaMsg, so an advancing value proves frames arrived, not that any carried sys.toapp_report_data. Upstream pymammotion has `last_report_data_at`, set only on frames carrying position, and it is NOT in our pinned chorty-0.8.12.post3.",
  "the_instrument_that_would": "report_stream_sequence_probe, run across a MOTION window -- a stationary run characterises the idle feed, which is a different case."
 },
 "probe_defect_found_by_its_own_first_run": {
  "finding": "THE STEP PROBE CANNOT DIAGNOSE ITS OWN FAILURE MODE.",
  "detail": "Its samples record `last_report_at_monotonic` but NOT position sequence or epoch, so when the feed freezes it cannot say whether payloads were stale or absent. Sample keys are index, elapsed_ms, captured_at, last_report_at_monotonic, position, vio, active_command.",
  "fix": "add position sequence and epoch to the in-window sample. Without it a retry may fail identically and be equally uninterpretable.",
  "status": "NOT FIXED. Recorded, not implemented."
 },
 "reconnect_correlation": {
  "observation": "Both occurrences of blind travel followed a reconnect. Attempt 3 ran at baseline_position_epoch 2 where earlier runs ran at 1; this run followed the HA restart for the beta83 deploy, which re-established BLE.",
  "status": "n = 2. A PATTERN WORTH RECORDING AND STILL NOT A MECHANISM. It sharpens where to point report_stream_sequence_probe; it is not a diagnosis.",
  "prior": "docs/phase2-steering-attempt3-blind-travel-20260827.md"
 },
 "what_DID_work": {
  "probe_failed_closed": "The travel guard tripped on the frozen feed rather than letting the run continue blind -- beta72's design, working. Cumulative distance was 0, so this was the stale-feed trip and not a distance trip.",
