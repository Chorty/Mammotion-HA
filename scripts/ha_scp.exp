#!/usr/bin/expect -f
# Copy a local file to the Home Assistant host at 192.168.1.106:2224.
#
# Usage:  scripts/ha_scp.exp <local-path> <remote-path>
# Requires HA_SSH_PASS in the environment:  set -a && source .env && set +a
#
# The password is read from the environment and never echoed (log_user 0 while
# it is sent). sshpass is not installed on this machine, hence expect.
set timeout 120
log_user 0
if {![info exists env(HA_SSH_PASS)]} {
    puts stderr "ha_scp.exp: HA_SSH_PASS is not set (run: set -a && source .env && set +a)"
    exit 2
}
set pw $env(HA_SSH_PASS)
set src [lindex $argv 0]
set dst [lindex $argv 1]
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P 2224 $src root@192.168.1.106:$dst
expect {
    -re "(P|p)assword:" { send -- "$pw\r"; exp_continue }
    "Are you sure you want to continue connecting" { send -- "yes\r"; exp_continue }
    eof
}
catch wait result
log_user 1
exit [lindex $result 3]
