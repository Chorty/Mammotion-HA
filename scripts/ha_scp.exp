#!/usr/bin/expect -f
# Copy a local file to the Home Assistant host at 192.168.1.106:2224.
#
# Usage:  scripts/ha_scp.exp <local-path> <remote-path>
# Requires HA_SSH_PASS in the environment:  set -a && source .env && set +a
#
# The password is read from the environment and never echoed (log_user is 0
# until after it is sent, and it is sent at most once). sshpass is not installed on this machine, hence expect.
set timeout 120
log_user 0
if {![info exists env(HA_SSH_PASS)]} {
    puts stderr "ha_scp.exp: HA_SSH_PASS is not set (run: set -a && source .env && set +a)"
    exit 2
}
set pw $env(HA_SSH_PASS)
set src [lindex $argv 0]
set dst [lindex $argv 1]
set authenticated 0
# -O: the HA SSH app only speaks the legacy SCP protocol (no SFTP subsystem).
spawn scp -O -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P 2224 $src root@192.168.1.106:$dst
expect {
    -re "(P|p)assword:" {
        # exp_continue re-arms this pattern for the rest of the session, so remote
        # output merely containing "password:" would otherwise re-trigger this
        # branch and resend the real secret mid-stream.
        if {$authenticated == 0} {
            send -- "$pw\r"
            set authenticated 1
            log_user 1
        }
        exp_continue
    }
    "Are you sure you want to continue connecting" { send -- "yes\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]
